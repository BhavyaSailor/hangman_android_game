<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color with a soft tint -->
    <gradient
        android:startColor="#B281DB"
    android:endColor="#5F7FC7"
    android:angle="270"/>



    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Padding inside -->
    <padding
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />

    <!-- Optional border stroke -->
    <stroke
        android:width="2dp"
        android:color="#FFFFFF" />
</shape>
