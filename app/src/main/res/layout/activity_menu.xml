<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/menuRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="16dp"
    tools:context=".MenuActivity">

    <!-- Center card -->
    <!--    <androidx.cardview.widget.CardView-->
    <!--        android:id="@+id/menuCard"-->
    <!--        android:layout_width="0dp"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        app:cardCornerRadius="20dp"-->

    <!--        app:cardBackgroundColor="?attr/colorSurface"-->
    <!--        app:layout_constraintWidth_min="300dp"-->
    <!--        app:layout_constraintWidth_max="600dp"-->
    <!--        app:layout_constraintTop_toTopOf="parent"-->
    <!--        app:layout_constraintBottom_toBottomOf="parent"-->
    <!--        app:layout_constraintStart_toStartOf="parent"-->
    <!--        app:layout_constraintEnd_toEndOf="parent">-->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <!-- App title -->
        <ImageView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/art"
            android:text="Hangman"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:layout_gravity="center"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="?attr/colorOnSurface"
            android:textSize="40sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Buttons stacked vertically -->
        <Button
            android:id="@+id/btnLevels"
            style="@style/MenuButton"
            android:background="@drawable/menu_button_bg"
            android:layout_width="240dp"
            android:layout_marginTop="24dp"
            app:backgroundTint="@null"
            android:text="Levels"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <Button
            android:id="@+id/btnRandom"
            style="@style/MenuButton"
            android:layout_width="240dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/menu_button_bg"
            app:backgroundTint="@null"
            android:text="Random Game"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnLevels" />

        <Button
            android:id="@+id/btnHowToPlay"
            style="@style/MenuButton"
            android:layout_width="240dp"
            android:background="@drawable/menu_button_bg"
            app:backgroundTint="@null"
            android:layout_marginTop="16dp"
            android:text="How To PLay?"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRandom" />

        <Button
            android:id="@+id/btnSettings"
            style="@style/MenuButton"
            android:background="@drawable/menu_button_bg"
            app:backgroundTint="@null"
            android:layout_width="240dp"
            android:layout_marginTop="16dp"
            android:text="Settings"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnHowToPlay" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
